{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- $minTagPosts := .Site.Params.minTagPostsToIndex | default 2 -}}
  {{- range .Site.Pages -}}
    {{- $exclude := or (eq .Layout "search") (eq .Kind "404") (and (eq .Kind "term") (lt (len .Pages) $minTagPosts)) -}}
    {{- if and (not $exclude) .Permalink }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ with .Lastmod }}
    <lastmod>{{ .Format "2006-01-02T15:04:05Z07:00" }}</lastmod>{{ end }}
  </url>
    {{- end -}}
  {{- end }}
</urlset>
